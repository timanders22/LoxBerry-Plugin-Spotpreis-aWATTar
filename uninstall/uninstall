#!/bin/bash
# Spotpreis aWATTar - uninstall
# command <TEMPFOLDER> <NAME> <FOLDER> <VERSION> <BASEFOLDER>
#
# Wird von LoxBerry als root ausgefuehrt. Rueckgabewert 0 = in Ordnung,
# 1 = Warnung (die Deinstallation laeuft trotzdem weiter).
#
# ===================================================================
# WARUM ES DIESE DATEI GIBT
# ===================================================================
#
# LoxBerry raeumt beim Deinstallieren alle Ordner weg, die dem Plugin
# gehoeren - bin/, config/, data/, log/, templates/ und die beiden
# webfrontend-Ordner - und entfernt den Cron-Eintrag. Vier Dinge liegen
# aber ausserhalb und blieben sonst liegen:
#
#   1. config/plugins/<ordner>.backup.json
#      Diese Sicherung liegt bewusst NEBEN dem Konfigordner, damit die
#      Tarifeinstellungen ein Update ueberstehen (spot_paths()['backup'],
#      postinstall.sh, postupgrade.sh). Eine Neuinstallation uebernimmt sie
#      nicht: preinstall.sh legt eine liegengebliebene Zweitschrift nach
#      <ordner>.backup.json.alt (Entscheidung 1 vom 29.09.2026). Bis dahin
#      stand hier "und sogar eine Neuinstallation"; die Zweitschrift wurde
#      dabei ohne Meldung eingespielt (Pruefbericht installer, Fall D).
#      Beim Deinstallieren gehoert sie weg.
#
#   2. /tmp/<ordner>
#      Zwischenspeicher fuer Marktdaten, Ansage-Merker und die
#      MQTT-Signatur. /tmp ist auf dem LoxBerry eine Ramdisk, der Ordner
#      verschwindet also spaetestens beim naechsten Neustart - bis dahin
#      wuerde er aber weiter dastehen.
#
#      DER NAME KOMMT AUS DEM ARGUMENT, nicht fest aus dem Skript. Bis
#      1.2.19 stand hier /tmp/spotpreis; seit 1.2.20 heisst der
#      Zwischenspeicher /tmp/<ordner>, damit sich zwei Installationen
#      nicht denselben Zustand und dieselbe Sperrdatei teilen. Mit dem
#      festen Namen haette dieses Skript entweder den Speicher der
#      anderen Installation abgeraeumt oder den eigenen stehen lassen.
#
#   3. data/plugins/<ordner>.upgrade_sicherung
#      Seit 1.2.9 liegt die Sicherung beim Aktualisieren NEBEN dem
#      Datenordner, weil purge_installation ihn auch im Upgrade-Zweig
#      bedingungslos loescht (sbin/plugininstall.pl :886, :1629 ff.).
#      Genau deshalb uebersteht sie auch das Deinstallieren. Darin liegt
#      history.csv - die Preisgeschichte, keine Zugangsdaten, aber sie
#      gehoert nach dem Entfernen nicht mehr auf die Karte.
#
#   4. Reste nach Entscheidung 1, nur wenn vorhanden:
#      config/plugins/<ordner>.backup.json.alt und
#      data/plugins/<ordner>.upgrade_sicherung.alt (von preinstall.sh bei
#      einer Neuinstallation beiseitegelegt) und die Marke
#      data/plugins/<ordner>.upgrade_laeuft eines abgebrochenen Updates.
#      Ohne diese Zeilen bliebe die beiseitegelegte Zweitschrift mit dem
#      Aktionstoken nach der Deinstallation liegen (Pruefbericht installer,
#      Fall G), und eine liegengebliebene Marke liesse eine spaetere
#      Neuinstallation als Aktualisierung laufen.
#
# ZU MQTT: Bis 1.2.27 stand hier, das Plugin setze kein Retain. Das stimmte
# seit 1.2.24 nicht mehr - elf Themen gingen zurueckbehalten hinaus
# (spot_retain_liste(); Bestand-2026-09-18/klasse-E, Liste vom 19.09.2026).
# Seit 1.2.28 leert dieses Skript die Themen der Linie unter dem eingestellten
# Praefix und liest beim Broker nach (weiter unten). Seit dem Durchgang
# 01.10.2026 (M1) auch unter jedem frueher eingestellten Praefix, das sich
# das Plugin beim Wechsel gemerkt hat (data/plugins/<ordner>/
# mqtt_praefixe.json). Stehen bleiben nur Themen unter einem Praefix, das
# vor dieser Fassung gewechselt wurde - davon weiss das Plugin nichts.

PDIR=$3
[ -n "$PDIR" ] || PDIR="spotpreis"
BASE="${5:-$LBHOMEDIR}"
# Die Wurzel: $5 (vom Installer) oder $LBHOMEDIR, wenn dort config/plugins
# und data/plugins liegen - sonst vom eigenen Ablageort AUFWAERTS SUCHEN, bis
# ein Verzeichnis config/plugins, data/plugins UND config/system/general.json
# traegt. Keine feste Ebenenzahl und kein fest verdrahteter Systempfad danach.
# Findet sich nichts, wird GEWARNT statt vollzogen.
#
# Bis 1.2.27 stand hier als Rueckfall fest das Verzeichnis drei Ebenen
# ueber dem eigenen Ablageort, ohne general.json. Aus einem Archiv drei
# Ebenen unter einem fremden Baum und
# aus einem fremden Baum heraus loeschte die Deinstallation dort die
# Zweitschrift (in WSL gemessen,
# Pruefung-Spotpreis-aWATTar-1.2.28, Faelle K1 und K4). general.json ist die
# Bedingung aus dem Raumklima-Vorfall (Regeln/06): ein LoxBerry hat die Datei
# immer, ein Pruefstandsrest nie. Bauart Spotpreis-Tibber 0.9.18.
sp_wurzel_suchen() {
    sp_v=$(cd "$1" 2>/dev/null && pwd -P) || return 1
    sp_i=0
    while [ -n "$sp_v" ] && [ "$sp_v" != "/" ] && [ "$sp_i" -lt 8 ]; do
        if [ -d "$sp_v/config/plugins" ] && [ -d "$sp_v/data/plugins" ] \
           && [ -f "$sp_v/config/system/general.json" ]; then
            echo "$sp_v"
            return 0
        fi
        sp_v=$(dirname "$sp_v")
        sp_i=$((sp_i + 1))
    done
    return 1
}
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ] || [ ! -d "$BASE/data/plugins" ]; then
    BASE=$(sp_wurzel_suchen "$(dirname "$(readlink -f "$0")")") || BASE=""
fi
if [ -z "$BASE" ]; then
    echo "<WARNING> Es wurde kein LoxBerry-Wurzelverzeichnis gefunden: weder als"
    echo "<WARNING> fuenftes Argument noch in \$LBHOMEDIR, und oberhalb von"
    echo "<WARNING> $(dirname "$(readlink -f "$0")") traegt kein Verzeichnis"
    echo "<WARNING> config/plugins, data/plugins und config/system/general.json."
    echo "<WARNING> Es wurde NICHTS geloescht."
    exit 1
fi

# Die zurueckbehaltenen MQTT-Themen der Linie leeren - VOR dem Loeschen der
# Zweitschrift (fehlt die Konfiguration schon, nennt die Zweitschrift das
# Praefix). Bis 1.2.27 blieben sie nach dem Deinstallieren im Broker stehen,
# und nach jedem Neustart von Broker oder Gateway bekam der Miniserver sie
# wieder - von einem Plugin, das es nicht mehr gibt (in WSL gemessen,
# Pruefung-Spotpreis-aWATTar-1.2.28, Faelle U1 bis U7). Geleert wird ueber den
# Weg der Linie, den UDP-Eingang des Gateways, und beim Broker nachgelesen
# (spot_mqtt_leeren() in webfrontend/html/spot_lib.php; Bauart
# Spotpreis-Tibber 0.9.19). Als loxberry, nicht als root; stdin geschlossen,
# damit su nie auf eine Eingabe wartet.
SP_CRON="$BASE/bin/plugins/$PDIR/cron.php"
if command -v php >/dev/null 2>&1 && [ -f "$SP_CRON" ]; then
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su -s /bin/bash loxberry -c "$(printf '%q ' env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PDIR" \
            timeout 60 php "$SP_CRON" --mqtt-leeren)" < /dev/null 2>&1 || true
    else
        env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PDIR" timeout 60 php "$SP_CRON" --mqtt-leeren \
            < /dev/null 2>&1 || true
    fi
else
    echo "<INFO> PHP oder cron.php fehlt - zurueckbehaltene MQTT-Themen wurden nicht geleert."
fi

BK="$BASE/config/plugins/$PDIR.backup.json"
if [ -f "$BK" ]; then
    rm -f "$BK" && echo "<OK> Sicherung der Tarifeinstellungen entfernt: $PDIR.backup.json"
else
    echo "<INFO> Keine Sicherung ausserhalb des Plugin-Ordners vorhanden."
fi

# Nur den eigenen Ordner, und nur wenn es wirklich einer ist. Der Name kommt
# aus dem Argument - siehe Punkt 2 oben.
TMPD="/tmp/$PDIR"
if [ -d "$TMPD" ]; then
    rm -rf "$TMPD" && echo "<OK> Zwischenspeicher $TMPD entfernt."
fi
# Der alte, fest verdrahtete Ort aus Fassungen bis 1.2.19. Nur wenn er nicht
# ohnehin schon der eigene war, sonst stuende die Meldung zweimal da - und nur,
# wenn keine Installation "spotpreis" daneben lebt: seit 1.2.20 ist
# /tmp/spotpreis deren Zwischenspeicher. Bis 1.2.27 raeumte die Deinstallation
# einer Zweitinstallation ihn ab (in WSL gemessen,
# Pruefung-Spotpreis-aWATTar-1.2.28, Fall U8).
if [ "$PDIR" != "spotpreis" ] && [ -d "/tmp/spotpreis" ] \
   && [ ! -d "$BASE/config/plugins/spotpreis" ]; then
    rm -rf "/tmp/spotpreis" && echo "<OK> Alter Zwischenspeicher /tmp/spotpreis entfernt."
fi

# Der Nachbar des Datenordners - siehe Punkt 3 oben.
SICH="$BASE/data/plugins/$PDIR.upgrade_sicherung"
if [ -d "$SICH" ]; then
    rm -rf "$SICH" && echo "<OK> Sicherung des Aktualisierens entfernt: $PDIR.upgrade_sicherung"
fi

# Punkt 4 oben: nur melden, was da war. Gepruefte Pfade - der Ordnername
# darf keinen Pfadtrenner tragen.
case "$PDIR" in
    */*|*..*)
        echo "<WARNING> Unzulaessiger Ordnername '$PDIR' - .alt-Ablagen und Marke wurden nicht abgeraeumt." ;;
    *)
        # Dazu die eigene Sperrdatei des Minutenlaufs (bin/cron.php,
        # sys_get_temp_dir() . '/<ordner>_cron.lock', seit dem Durchgang
        # 01.10.2026 je Installation). Die alte, geteilte plugins_cron.lock
        # bleibt: sie kann einer anderen Installation gehoeren.
        for SP_REST in "$BK.alt" "$SICH.alt" "$BASE/data/plugins/$PDIR.upgrade_laeuft" "/tmp/${PDIR}_cron.lock"; do
            if [ -e "$SP_REST" ] || [ -L "$SP_REST" ]; then
                rm -rf "${SP_REST:?}" 2>/dev/null
                if [ -e "$SP_REST" ] || [ -L "$SP_REST" ]; then
                    echo "<WARNING> Liess sich nicht entfernen: $SP_REST"
                else
                    echo "<OK> Entfernt: $(basename "$SP_REST")"
                fi
            fi
        done ;;
esac

echo "<INFO> Zurueckbehaltene MQTT-Themen unter einem Praefix, das VOR dieser Fassung"
echo "<INFO> gewechselt wurde, kennt das Plugin nicht und raeumt sie nicht ab. Nachsehen:"
echo "<INFO> mosquitto_sub -t '<praefix>/#' --retained-only"
exit 0
